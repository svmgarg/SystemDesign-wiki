    {
      "id": "0oGL3kSjoPCh7z-s55VUX",
      "type": "text",
      "x": -3922.5109154030297,
      "y": -4130.520822650787,
      "width": 1540,
      "height": 50,
      "text": "Return the payment order / session to the client. The client pays the provider; only verified provider confirmation advances booking.\nCreation retries use a stable payment idempotency key. Holds are temporary; they do not guarantee a ticket.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1431370750,
      "version": 55,
      "versionNonce": 1166148962,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310017438,
      "link": null,
      "locked": false,
      "index": "b7m",
      "frameId": null,
      "roundness": null,
      "created": 1792310015908,
      "originalText": "Return the payment order / session to the client. The client pays the provider; only verified provider confirmation advances booking.\nCreation retries use a stable payment idempotency key. Holds are temporary; they do not guarantee a ticket.",
      "labelPosition": null,
      "baseFontSize": null
    },
