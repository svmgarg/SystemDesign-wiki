      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310480064,
      "link": null,
      "locked": false,
      "index": "bAf",
      "frameId": null,
      "roundness": null,
      "created": 1792310473370,
      "originalText": "Redis (one shared store)\nFast seat map + provisional holds\n\nHash: event:{E1}:seats\nHold: hold:{E1}:seatId, TTL <= 10 min\nJSON: reservationId, userId,\nbookingId / orderId when known\nBOOKED > active hold > AVAILABLE\nHolds + sold state mirror PostgreSQL\nNot the final reservation authority",
      "labelPosition": null,
      "baseFontSize": null
