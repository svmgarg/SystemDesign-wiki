    {
      "id": "7AE7GaN2IN57d6GT-SpJw",
      "type": "rectangle",
      "x": -3922.5109154030297,
      "y": -3670.5208226507866,
      "width": 470,
      "height": 245,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
