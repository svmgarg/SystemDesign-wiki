    },
    {
      "id": "9TMgFCFa-z0vCCH8oRZLh",
      "type": "text",
      "x": -3370.399080908758,
      "y": -3769.6290604921396,
      "width": 1530,
      "height": 25,
      "text": "Chosen tradeoff: stale Redis may grant a losing hold. PostgreSQL prevents a second confirmed sale; a collected losing payment is refunded.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
