      "type": "text",
      "x": -3362.4994829009484,
      "y": -1094.9897864328414,
      "width": 300,
      "height": 190,
      "text": "Booking Service\n1. Redis preliminary gate\n2. PostgreSQL grants hold\n4. PostgreSQL confirms sale\nStable booking / reservation ID\nAll selected seats or none",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.25,
