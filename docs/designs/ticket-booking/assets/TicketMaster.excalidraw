      "link": null,
      "locked": false,
      "index": "b9u",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "labelPosition": null,
