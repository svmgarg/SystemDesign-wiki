      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b5S",
      "frameId": null,
      "roundness": null,
      "created": 1792309050706,
      "originalText": "Redis: one atomic Lua operation\nCheck every selected seat is not sold\nCheck no active competing hold\nAcquire ALL holds, or NONE\nEach hold has a 600-second TTL",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "L-RI8hx0Jwu2VS-2Fc3bN",
