    {
      "id": "40-yYPZcvmZz7FOlUsyNs",
      "type": "text",
      "x": -3370.399080908758,
      "y": -4539.62906049214,
      "width": 1540,
      "height": 50,
      "text": "Read responses return to the client; return arrows omitted. Event details may be cached independently.\nNo PostgreSQL seat lookup on the normal read path. A seat map is a snapshot, not a reservation guarantee.",
