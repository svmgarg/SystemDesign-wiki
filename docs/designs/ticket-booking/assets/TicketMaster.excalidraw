    {
      "id": "dkdnLtH3nPeP-DdMM3_Ms",
      "type": "text",
      "x": -2497.4994829009484,
      "y": -1224.9897864328414,
      "width": 490,
      "height": 260,
      "text": "Redis (one shared store)\nFast seat map + provisional holds\n\nHash: event:{E1}:seats\nHold: hold:{E1}:seatId, TTL <= 10 min\nJSON: reservationId, userId,\nbookingId / orderId when known\nBOOKED > active hold > AVAILABLE\nHolds + sold state mirror PostgreSQL\nNot the final reservation authority",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": false,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [
