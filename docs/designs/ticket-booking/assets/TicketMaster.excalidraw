    {
      "id": "pY39bcbVu51mJk2AO9V4F",
      "type": "text",
      "x": 431.04119453448584,
      "y": 945.8304916158941,
      "width": 750,
      "height": 35,
      "text": "4. Redis model: no expiresAt field required",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 672219874,
      "version": 52,
      "versionNonce": 1782694462,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b66",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "4. Redis model: no expiresAt field required",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "K0piwiFyFBemBZsnMenmt",
      "type": "text",
      "x": 436.04119453448584,
      "y": 1010.8304916158941,
      "width": 740,
      "height": 265,
      "text": "Permanent hash: event:{E1}:seats\n  1 -> AVAILABLE\n  2 -> AVAILABLE\n  3 -> BOOKED (bookingId: B3)\n\nTemporary key: hold:{E1}:2\n  JSON: { reservationId: R1, userId: U1 }\n  TTL: 600 seconds\n  Optional: bookingId / orderId when known\n\nSeat identifiers: 1..N for each event.",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1953142434,
      "version": 52,
      "versionNonce": 627116194,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b67",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "Permanent hash: event:{E1}:seats\n  1 -> AVAILABLE\n  2 -> AVAILABLE\n  3 -> BOOKED (bookingId: B3)\n\nTemporary key: hold:{E1}:2\n  JSON: { reservationId: R1, userId: U1 }\n  TTL: 600 seconds\n  Optional: bookingId / orderId when known\n\nSeat identifiers: 1..N for each event.",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "As5pBkAAaJjeKU2U5ea-5",
      "type": "text",
      "x": 436.04119453448584,
      "y": 1300.830491615894,
      "width": 740,
      "height": 205,
      "text": "Effective seat-map status:\n  BOOKED in permanent hash -> BOOKED\n  Otherwise, active hold key -> RESERVED\n  Otherwise -> AVAILABLE\n\nTTL removes the entire hold; no move between seat arrays.\nHGETALL / HMGET + batched MGET for hold keys.\nRedis Cluster: same-event keys share the {E1} hash tag\nso multi-key scripts execute in one slot.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1508078178,
      "version": 52,
      "versionNonce": 596298366,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b68",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "Effective seat-map status:\n  BOOKED in permanent hash -> BOOKED\n  Otherwise, active hold key -> RESERVED\n  Otherwise -> AVAILABLE\n\nTTL removes the entire hold; no move between seat arrays.\nHGETALL / HMGET + batched MGET for hold keys.\nRedis Cluster: same-event keys share the {E1} hash tag\nso multi-key scripts execute in one slot.",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "4S8Qa46VHFcOo2NRQiVQq",
      "type": "rectangle",
      "x": 1251.0411945344858,
      "y": 920.8304916158941,
      "width": 810,
      "height": 610,
      "strokeColor": "#6741d9",
      "backgroundColor": "#f3f0ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
