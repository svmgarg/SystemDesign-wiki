    {
      "id": "5F0SI6JmRsvEo2BywSqSg",
      "type": "text",
      "x": -3937.5109154030297,
      "y": -3995.5208226507866,
      "width": 1530,
      "height": 35,
      "text": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 56923262,
      "version": 55,
      "versionNonce": 1537149218,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310017438,
      "link": null,
      "locked": false,
      "index": "b7o",
      "frameId": null,
      "roundness": null,
      "created": 1792310015908,
      "originalText": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "7aq9iR6cGKfk7DxwiIbP6",
      "type": "text",
      "x": -3922.5109154030297,
      "y": -3940.5208226507866,
      "width": 1530,
      "height": 25,
      "text": "Chosen tradeoff: stale Redis may grant a losing hold. PostgreSQL prevents a second confirmed sale; a collected losing payment is refunded.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#9c3600",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 756634814,
      "version": 55,
      "versionNonce": 2022380030,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310017438,
      "link": null,
      "locked": false,
      "index": "b7p",
      "frameId": null,
      "roundness": null,
      "created": 1792310015908,
      "originalText": "Chosen tradeoff: stale Redis may grant a losing hold. PostgreSQL prevents a second confirmed sale; a collected losing payment is refunded.",
      "labelPosition": null,
      "baseFontSize": null
    },
