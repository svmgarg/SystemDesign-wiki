    {
      "id": "yaF5ymKftKzpfTxAhBjEg",
      "type": "text",
      "x": 1966.056965160814,
      "y": -1839.2019310883372,
      "width": 726.2918090820312,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4r",
      "roundness": null,
      "seed": 121895650,
      "version": 17,
      "versionNonce": 73687230,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "created": 1792307829158,
      "link": null,
      "locked": false,
      "text": "Redis State \nPermanent seat state:\n  event:E1:seats\n      1 → AVAILABLE\n      2 → AVAILABLE\n      3 → BOOKED\n\nTemporary hold:\n  hold:E1:2\n      → { reservationId: R1, userId: U1, orderId: O1 }\n      → TTL: 600 seconds",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis State \nPermanent seat state:\n  event:E1:seats\n      1 → AVAILABLE\n      2 → AVAILABLE\n      3 → BOOKED\n\nTemporary hold:\n  hold:E1:2\n      → { reservationId: R1, userId: U1, orderId: O1 }\n      → TTL: 600 seconds",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
