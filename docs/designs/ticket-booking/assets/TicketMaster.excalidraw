    },
    {
      "id": "anu7-HRZ0q7IE_6A9kVCJ",
      "type": "text",
      "x": -2402.4951447767016,
      "y": -6050.553245355019,
      "width": 726.2918090820312,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6y",
      "roundness": null,
      "seed": 1358591870,
      "version": 20,
      "versionNonce": 1759727522,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310017438,
      "created": 1792310015907,
      "link": null,
      "locked": false,
      "text": "Redis State \nPermanent seat state:\n  event:E1:seats\n      1 → AVAILABLE\n      2 → AVAILABLE\n      3 → BOOKED\n\nTemporary hold:\n  hold:E1:2\n      → { reservationId: R1, userId: U1, orderId: O1 }\n      → TTL: 600 seconds",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis State \nPermanent seat state:\n  event:E1:seats\n      1 → AVAILABLE\n      2 → AVAILABLE\n      3 → BOOKED\n\nTemporary hold:\n  hold:E1:2\n      → { reservationId: R1, userId: U1, orderId: O1 }\n      → TTL: 600 seconds",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
