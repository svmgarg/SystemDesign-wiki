      "link": null,
      "locked": false,
      "index": "b5j",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "Chosen tradeoff: stale Redis may grant a losing hold. PostgreSQL prevents a second confirmed sale; a collected losing payment is refunded.",
      "labelPosition": null,
      "baseFontSize": null
    },
