      "type": "text",
      "x": -3385.399080908758,
      "y": -3824.6290604921396,
      "width": 1530,
      "height": 35,
      "text": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
