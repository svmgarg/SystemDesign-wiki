    {
      "id": "4B_CXtUlOsTCW9oy1gPSW",
      "type": "text",
      "x": 431.04119453448584,
      "y": 215.83049161589406,
      "width": 1530,
      "height": 35,
      "text": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1611450594,
      "version": 52,
      "versionNonce": 1399648062,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b5i",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "3. Confirm payment: PostgreSQL commit first, then update Redis",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "vlj87XzommMyhbKPU9qsn",
      "type": "text",
      "x": 446.04119453448584,
      "y": 270.83049161589406,
      "width": 1530,
      "height": 25,
      "text": "Chosen tradeoff: stale Redis may grant a losing hold. PostgreSQL prevents a second confirmed sale; a collected losing payment is refunded.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#9c3600",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1862622370,
      "version": 52,
