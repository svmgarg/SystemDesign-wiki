    },
    {
      "id": "UMXhs8d39q72-VeC8BilN",
      "type": "text",
      "x": -2535.399080908758,
      "y": -3094.6290604921396,
      "width": 750,
      "height": 35,
      "text": "5. Guarantees, recovery and deliberate tradeoffs",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 713711842,
      "version": 54,
      "versionNonce": 350552162,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "bAM",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "5. Guarantees, recovery and deliberate tradeoffs",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "AaelgbPc2JUuy7UiNRlc0",
      "type": "text",
      "x": -2530.399080908758,
      "y": -3029.6290604921396,
      "width": 740,
      "height": 500,
      "text": "STRICT CONFIRMED SEAT OWNERSHIP\nPostgreSQL uniqueness + transaction prevent two confirmed\nbookings owning the same (event_id, seat_id).\nStable booking / payment IDs make retries idempotent.\n\nFAST BUT POTENTIALLY STALE AVAILABILITY\nRedis grants temporary holds, not guaranteed tickets.\nStale Redis can lead to a rejected paid attempt and refund.\nNo claim of strongly consistent seat-map reads.\n\nREDIS LOSS / REBUILD\nGate new holds during recovery. Restore confirmed sold seats\nfrom PostgreSQL before reopening. Reconcile in-flight payments\nand lost holds; do not treat an empty Redis as an empty venue.\n\nPOSTGRESQL REPAIR OF REDIS\nUse repeatable reconciliation; outbox is an optional mechanism.\nRedis errors do not invalidate already-committed tickets.\n\nDEFERRED / NOT ASSUMED\nEvent creation and initialization are outside this review.\nNo Redis Stream / async PostgreSQL confirmation in this version.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1175450786,
      "version": 54,
      "versionNonce": 1479749310,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "bAN",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "STRICT CONFIRMED SEAT OWNERSHIP\nPostgreSQL uniqueness + transaction prevent two confirmed\nbookings owning the same (event_id, seat_id).\nStable booking / payment IDs make retries idempotent.\n\nFAST BUT POTENTIALLY STALE AVAILABILITY\nRedis grants temporary holds, not guaranteed tickets.\nStale Redis can lead to a rejected paid attempt and refund.\nNo claim of strongly consistent seat-map reads.\n\nREDIS LOSS / REBUILD\nGate new holds during recovery. Restore confirmed sold seats\nfrom PostgreSQL before reopening. Reconcile in-flight payments\nand lost holds; do not treat an empty Redis as an empty venue.\n\nPOSTGRESQL REPAIR OF REDIS\nUse repeatable reconciliation; outbox is an optional mechanism.\nRedis errors do not invalidate already-committed tickets.\n\nDEFERRED / NOT ASSUMED\nEvent creation and initialization are outside this review.\nNo Redis Stream / async PostgreSQL confirmation in this version.",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "fczAtnx32Rhvy3v-fNiso",
      "type": "text",
      "x": -4097.499482900948,
      "y": -2334.9897864328414,
      "width": 2810,
      "height": 50,
      "text": "Ticket booking - layered architecture",
      "fontSize": 36,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1700253694,
      "version": 110,
      "versionNonce": 1918140094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310480064,
      "link": null,
      "locked": false,
      "index": "bAO",
      "frameId": null,
      "roundness": null,
      "created": 1792310473370,
      "originalText": "Ticket booking - layered architecture",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "zO2CeclxY5ljwYsJmtJWO",
      "type": "text",
      "x": -4097.499482900948,
      "y": -2269.9897864328414,
      "width": 2810,
      "height": 60,
      "text": "One connected diagram; one Redis and one PostgreSQL. Redis is a preliminary gate; PostgreSQL owns actual holds and confirmed bookings.\nSolid arrows: application calls. Dashed arrows: fallback / synchronization. Responses return through the caller; most return arrows are omitted.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1947803710,
      "version": 110,
      "versionNonce": 51508990,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310480064,
      "link": null,
      "locked": false,
      "index": "bAP",
      "frameId": null,
      "roundness": null,
      "created": 1792310473370,
      "originalText": "One connected diagram; one Redis and one PostgreSQL. Redis is a preliminary gate; PostgreSQL owns actual holds and confirmed bookings.\nSolid arrows: application calls. Dashed arrows: fallback / synchronization. Responses return through the caller; most return arrows are omitted.",
      "labelPosition": null,
      "baseFontSize": null
    },
