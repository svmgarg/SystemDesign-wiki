      "type": "text",
      "x": -1850.3833102824303,
      "y": -5879.661483196371,
      "width": 726.2918090820312,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
