    {
      "id": "UiuKdevoNI7kKRP4Xxi9Q",
      "type": "text",
      "x": -3395.399080908758,
      "y": -5154.62906049214,
      "width": 1580,
      "height": 50,
      "text": "Redis owns temporary holds. PostgreSQL is the final authority for confirmed seat allocations.\nScope: reads, booking and recovery. Event creation / seat initialization are deferred.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
