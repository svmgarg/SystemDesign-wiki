    },
    {
      "id": "kSx28xwVddaW_IrwqzdoR",
      "type": "text",
      "x": -3385.399080908758,
      "y": -3094.6290604921396,
      "width": 750,
      "height": 35,
      "text": "4. Redis model: no expiresAt field required",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 2123588066,
      "version": 54,
      "versionNonce": 1283346658,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "bAI",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "4. Redis model: no expiresAt field required",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "qA8Bxze36NhfL9ExmJek5",
      "type": "text",
      "x": -3380.399080908758,
      "y": -3029.6290604921396,
      "width": 740,
      "height": 265,
      "text": "Permanent hash: event:{E1}:seats\n  1 -> AVAILABLE\n  2 -> AVAILABLE\n  3 -> BOOKED (bookingId: B3)\n\nTemporary key: hold:{E1}:2\n  JSON: { reservationId: R1, userId: U1 }\n  TTL: 600 seconds\n  Optional: bookingId / orderId when known\n\nSeat identifiers: 1..N for each event.",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 324064674,
      "version": 54,
      "versionNonce": 2113218110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "bAJ",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "Permanent hash: event:{E1}:seats\n  1 -> AVAILABLE\n  2 -> AVAILABLE\n  3 -> BOOKED (bookingId: B3)\n\nTemporary key: hold:{E1}:2\n  JSON: { reservationId: R1, userId: U1 }\n  TTL: 600 seconds\n  Optional: bookingId / orderId when known\n\nSeat identifiers: 1..N for each event.",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1W_SJ7eyqBU6E62cWFE8Y",
      "type": "text",
      "x": -3380.399080908758,
      "y": -2739.6290604921396,
      "width": 740,
      "height": 205,
      "text": "Effective seat-map status:\n  BOOKED in permanent hash -> BOOKED\n  Otherwise, active hold key -> RESERVED\n  Otherwise -> AVAILABLE\n\nTTL removes the entire hold; no move between seat arrays.\nHGETALL / HMGET + batched MGET for hold keys.\nRedis Cluster: same-event keys share the {E1} hash tag\nso multi-key scripts execute in one slot.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1604964706,
      "version": 54,
      "versionNonce": 1678107810,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "bAK",
      "frameId": null,
      "roundness": null,
      "created": 1792310018797,
      "originalText": "Effective seat-map status:\n  BOOKED in permanent hash -> BOOKED\n  Otherwise, active hold key -> RESERVED\n  Otherwise -> AVAILABLE\n\nTTL removes the entire hold; no move between seat arrays.\nHGETALL / HMGET + batched MGET for hold keys.\nRedis Cluster: same-event keys share the {E1} hash tag\nso multi-key scripts execute in one slot.",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "gpcrEEkqrOVG_Et1tt6mE",
      "type": "rectangle",
      "x": -2565.399080908758,
      "y": -3119.6290604921396,
      "width": 810,
      "height": 610,
      "strokeColor": "#6741d9",
      "backgroundColor": "#f3f0ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
