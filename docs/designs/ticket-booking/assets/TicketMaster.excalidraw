    {
      "id": "KDO3rKDD29llHV_vB9Lvf",
      "type": "text",
      "x": 1096.0411945344858,
      "y": -269.16950838410594,
      "width": 340,
      "height": 120,
      "text": "Redis: one atomic Lua operation\nCheck every selected seat is not sold\nCheck no active competing hold\nAcquire ALL holds, or NONE\nEach hold has a 600-second TTL",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": false,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
