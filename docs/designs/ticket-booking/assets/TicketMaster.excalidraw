    {
      "id": "EwkoVAEmOvu3hX-wmwgKQ",
      "type": "rectangle",
      "x": 446.04119453448584,
      "y": 540.8304916158941,
      "width": 470,
      "height": 245,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
