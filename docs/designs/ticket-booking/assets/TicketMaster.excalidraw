    {
      "id": "xbxbiDTDITjbmL47u-xL0",
      "type": "text",
      "x": 446.04119453448584,
      "y": 80.83049161589406,
      "width": 1540,
      "height": 50,
      "text": "Return the payment order / session to the client. The client pays the provider; only verified provider confirmation advances booking.\nCreation retries use a stable payment idempotency key. Holds are temporary; they do not guarantee a ticket.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 1260796258,
      "version": 52,
      "versionNonce": 1589214974,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792310009820,
      "link": null,
      "locked": false,
      "index": "b5g",
      "frameId": null,
      "roundness": null,
      "created": 1792309050707,
      "originalText": "Return the payment order / session to the client. The client pays the provider; only verified provider confirmation advances booking.\nCreation retries use a stable payment idempotency key. Holds are temporary; they do not guarantee a ticket.",
      "labelPosition": null,
      "baseFontSize": null
    },
