      "index": "bAd",
      "frameId": null,
      "roundness": null,
      "created": 1792310473370,
      "originalText": "Booking Service\n1. Redis preliminary gate\n2. PostgreSQL grants hold\n4. PostgreSQL confirms sale\nStable booking / reservation ID\nAll selected seats or none",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "V64LBsfxZP7FWz_ZvkMIu",
