    {
      "id": "vcUkdJ0xc8CVajYS2wsIz",
      "type": "text",
      "x": -2720.399080908758,
      "y": -4309.62906049214,
      "width": 340,
      "height": 120,
      "text": "Redis: one atomic Lua operation\nCheck every selected seat is not sold\nCheck no active competing hold\nAcquire ALL holds, or NONE\nEach hold has a 600-second TTL",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": false,
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "seed": 2126572514,
      "version": 54,
      "versionNonce": 190338530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792310018798,
      "link": null,
      "locked": false,
      "index": "b9e",
      "frameId": null,
      "roundness": null,
      "created": 1792310018796,
      "originalText": "Redis: one atomic Lua operation\nCheck every selected seat is not sold\nCheck no active competing hold\nAcquire ALL holds, or NONE\nEach hold has a 600-second TTL",
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ecCZSW706gBqA9mD4ItAF",
      "type": "text",
      "x": -2295.399080908758,
      "y": -4314.62906049214,
      "width": 470,
      "height": 140,
      "text": "Hold conflict -> return unavailable;\nrefresh the client's seat map.\n\nNo payment -> hold keys expire.\nNo temporary reservation write to PostgreSQL.",
