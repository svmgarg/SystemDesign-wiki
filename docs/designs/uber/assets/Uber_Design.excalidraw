    {
      "id": "VPQfL-SmoFZNfqpdzpwJZ",
      "type": "text",
      "x": -371.4680777748189,
      "y": -4060.1084829469264,
      "width": 1152.919189453125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCz",
      "roundness": null,
      "seed": 462050693,
      "version": 845,
      "versionNonce": 140498885,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "zf5fmTOZO9AOruybQFJeP",
          "type": "arrow"
        }
      ],
      "updated": 1792817306620,
      "created": 1792817033352,
      "link": null,
      "locked": false,
      "text": "\n1. For a Ride, Query the Driver Location Store to get top K nearby free Driver\n\n2. This service will be processing each Offer as Task with a Thread pool.\n3. Try get the Lease lock for the Driver if succeed then send the offer request to Driver else check the next Driver.\n\n4. Driver might Accept and Reject the Offer.\n5. On Accept, Driver will update the Location + Status Store, \nMarking its Location as InRide, On Cancel Remove Lease Lock\n\n6. On Accept, Driver - Offer Store will be updated and passed the update towards DB.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n1. For a Ride, Query the Driver Location Store to get top K nearby free Driver\n\n2. This service will be processing each Offer as Task with a Thread pool.\n3. Try get the Lease lock for the Driver if succeed then send the offer request to Driver else check the next Driver.\n\n4. Driver might Accept and Reject the Offer.\n5. On Accept, Driver will update the Location + Status Store, \nMarking its Location as InRide, On Cancel Remove Lease Lock\n\n6. On Accept, Driver - Offer Store will be updated and passed the update towards DB.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
