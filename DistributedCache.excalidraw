    {
      "id": "h9HPaKuBum3xnmcops19J",
      "type": "text",
      "x": 1925.0383589348853,
      "y": -2945.7213712924067,
      "width": 800,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1282246057,
      "version": 296,
      "versionNonce": 1958823079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792152152066,
      "created": 1792152034563,
      "link": null,
      "locked": false,
      "text": "Benefits -\n1. High Avalibality as we have Read replica\neven if primary cache node went down cache \ncan serve with replica node.\n2. Scalablity = Cache can be further spilit \neasily very less data movement\n3. Low latency - As data is hold in memory.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Benefits -\n1. High Avalibality as we have Read replica\neven if primary cache node went down cache \ncan serve with replica node.\n2. Scalablity = Cache can be further spilit \neasily very less data movement\n3. Low latency - As data is hold in memory.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
